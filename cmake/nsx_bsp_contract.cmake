# SDK-owned BSP contract. One provider per configure context.
include_guard(GLOBAL)
include(CMakeParseArguments)

function(nsx_assert_bsp_contract_supported)
    cmake_parse_arguments(PARSE_ARGV 0 BSP "" "SOC;CONTRACT" "")
    if(BSP_UNPARSED_ARGUMENTS OR BSP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid BSP contract arguments")
    endif()
    if(NOT "${BSP_CONTRACT}" STREQUAL "2" OR
       NOT "${BSP_SOC}" MATCHES "^(apollo330P|apollo510)$")
        message(FATAL_ERROR "SDK BSP contract ${BSP_CONTRACT} is not qualified for SoC '${BSP_SOC}'")
    endif()
endfunction()

function(nsx_register_bsp)
    cmake_parse_arguments(PARSE_ARGV 0 BSP "" "TARGET;CONTRACT;DEBUG_ITM;DEBUG_UART" "")
    if(BSP_UNPARSED_ARGUMENTS OR BSP_KEYWORDS_MISSING_VALUES OR NOT BSP_TARGET)
        message(FATAL_ERROR "Invalid BSP registration arguments")
    endif()
    nsx_assert_bsp_contract_supported(SOC "${NSX_SOC_SKEW}" CONTRACT "${BSP_CONTRACT}")
    if(NOT "${NSX_BSP_CONTRACT_REQUIRED}" STREQUAL "2")
        message(FATAL_ERROR "Custom BSP v2 requires explicit NSX_BSP_CONTRACT_REQUIRED=2")
    endif()
    foreach(cap DEBUG_ITM DEBUG_UART)
        if(NOT "${BSP_${cap}}" MATCHES "^[01]$")
            message(FATAL_ERROR "BSP ${cap} must be an explicit literal 0 or 1")
        endif()
    endforeach()
    if(TARGET nsx::bsp)
        message(FATAL_ERROR "A BSP provider is already registered as nsx::bsp")
    endif()
    if(NOT TARGET "${BSP_TARGET}")
        message(FATAL_ERROR "BSP target '${BSP_TARGET}' does not exist")
    endif()
    get_target_property(alias "${BSP_TARGET}" ALIASED_TARGET)
    if(alias)
        message(FATAL_ERROR "Register the concrete BSP target, not an alias")
    endif()
    set_target_properties(${BSP_TARGET} PROPERTIES
        NSX_BSP_CONTRACT_VERSION 2
        NSX_BSP_DEBUG_ITM "${BSP_DEBUG_ITM}"
        NSX_BSP_DEBUG_UART "${BSP_DEBUG_UART}")
    add_library(nsx::bsp ALIAS ${BSP_TARGET})
endfunction()

function(nsx_validate_bsp out_target)
    if(NOT TARGET nsx::bsp)
        message(FATAL_ERROR "Selected BSP must be added before its consumers (missing nsx::bsp)")
    endif()
    get_target_property(provider nsx::bsp ALIASED_TARGET)
    if(NOT provider)
        message(FATAL_ERROR "nsx::bsp must alias the selected concrete provider")
    endif()
    set(required 1)
    if(DEFINED NSX_BSP_CONTRACT_REQUIRED)
        set(required "${NSX_BSP_CONTRACT_REQUIRED}")
    endif()
    get_target_property(version ${provider} NSX_BSP_CONTRACT_VERSION)
    # Compatibility only for the known SDK v1 adapter; a cache entry cannot
    # establish a custom provider contract.
    if(NOT version AND "${provider}" STREQUAL "nsx_ambiq_bsp" AND
       "${NSX_BSP_CONTRACT_VERSION}" STREQUAL "1")
        set(version 1)
    endif()
    if(NOT "${version}" STREQUAL "${required}")
        message(FATAL_ERROR "BSP contract mismatch: required ${required}, provider '${provider}' supplies ${version}")
    endif()
    if("${version}" STREQUAL "2")
        nsx_assert_bsp_contract_supported(SOC "${NSX_SOC_SKEW}" CONTRACT 2)
        foreach(cap DEBUG_ITM DEBUG_UART)
            get_target_property(value ${provider} NSX_BSP_${cap})
            if(NOT "${value}" MATCHES "^[01]$")
                message(FATAL_ERROR "BSP target property NSX_BSP_${cap} must be literal 0 or 1")
            endif()
        endforeach()
    elseif(NOT "${version}" STREQUAL "1" OR NOT "${provider}" STREQUAL "nsx_ambiq_bsp")
        message(FATAL_ERROR "Only the built-in SDK adapter may use the legacy BSP contract")
    endif()
    set(${out_target} "${provider}" PARENT_SCOPE)
endfunction()

function(nsx_configure_core_bsp target)
    nsx_validate_bsp(provider)
    get_target_property(version ${provider} NSX_BSP_CONTRACT_VERSION)
    if("${version}" STREQUAL "2")
        get_target_property(itm ${provider} NSX_BSP_DEBUG_ITM)
        get_target_property(uart ${provider} NSX_BSP_DEBUG_UART)
        target_compile_definitions(${target} PRIVATE
            NSX_CORE_BSP_CONTRACT=2 NSX_CORE_DEBUG_ITM=${itm} NSX_CORE_DEBUG_UART=${uart})
    endif()
endfunction()
